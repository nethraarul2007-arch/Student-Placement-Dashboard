{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start PlaceHub (Vite)",
            "type": "shell",
            "command": "npm run dev -- --host 127.0.0.1 --strictPort",
            "options": {
                "cwd": "${workspaceFolder}/placement-dashboard"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^(?:.*(?:error|Error|failed|Failed).*)$",
                    "message": 0
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "vite --host 127\\.0\\.0\\.1",
                    "endsPattern": "http://127\\.0\\.0\\.1:5173/"
                }
            }
        }
    ]
}
